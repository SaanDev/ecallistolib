   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of frequency channels: 200\n",
      "Number of time samples: 3600\n",
      "Observation duration: 899.75 seconds\n",
      "Frequency range: 15.0 - 86.6 MHz\n",
      "Observation start: 2022-04-30 13:45:01+00:00\n",
      "Observation end: 2022-04-30 14:00:00.750000+00:00\n"
     ]
    }
   ],
   "source": [
    "# Convenience properties\n",
    "print(f\"Number of frequency channels: {ds.n_freq}\")\n",
    "print(f\"Number of time samples: {ds.n_time}\")\n",
    "print(f\"Observation duration: {ds.duration_s:.2f} seconds\")\n",
