    "\n",
    "# New in v1.2.0: absolute observation datetimes\n",
    "print(f\"Observation start: {ds.start_datetime}\")\n",
    "print(f\"Observation end: {ds.end_datetime}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Parsing Filenames\n",
    "\n",
    "Extract metadata from e-CALLISTO filename format: `STATION_YYYYMMDD_HHMMSS_NN.fit.gz`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Station: ALASKA\n",
      "Date: 20230615\n",
      "Time: 143000\n",
      "Focus: 01\n"
     ]
    }
   ],
   "source": [
    "# Parse filename components\n",
    "parts = ecl.parse_callisto_filename(\"ALASKA_20230615_143000_01.fit.gz\")\n",
    "\n",
    "print(f\"Station: {parts.station}\")\n",
    "print(f\"Date: {parts.date_yyyymmdd}\")\n",
    "print(f\"Time: {parts.time_hhmmss}\")\n",
    "print(f\"Focus: {parts.focus}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "## 2. Downloading Data\n",
    "\n",
    "Download FITS files directly from the e-CALLISTO archive."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Found 18 files:\n",
      "  - ALASKA-ANCHORAGE_20230615_143000_01.fit.gz\n",
      "    URL: http://soleil80.cs.technik.fhnw.ch/solarradio/data/2002-20yy_Callisto/2023/06/15/ALASKA-ANCHORAGE_20230615_143000_01.fit.gz\n",
      "  - ALASKA-ANCHORAGE_20230615_144500_01.fit.gz\n",
      "    URL: http://soleil80.cs.technik.fhnw.ch/solarradio/data/2002-20yy_Callisto/2023/06/15/ALASKA-ANCHORAGE_20230615_144500_01.fit.gz\n",
      "  - ALASKA-COHOE_20230615_140000_62.fit.gz\n",
      "    URL: http://soleil80.cs.technik.fhnw.ch/solarradio/data/2002-20yy_Callisto/2023/06/15/ALASKA-COHOE_20230615_140000_62.fit.gz\n",
      "  - ALASKA-COHOE_20230615_140000_63.fit.gz\n",
      "    URL: http://soleil80.cs.technik.fhnw.ch/solarradio/data/2002-20yy_Callisto/2023/06/15/ALASKA-COHOE_20230615_140000_63.fit.gz\n",
      "  - ALASKA-COHOE_20230615_141500_62.fit.gz\n",
      "    URL: http://soleil80.cs.technik.fhnw.ch/solarradio/data/2002-20yy_Callisto/2023/06/15/ALASKA-COHOE_20230615_141500_62.fit.gz\n"
     ]
    }
   ],
   "source": [
    "# List available files for a specific day/hour/station\n",
    "remote_files = ecl.list_remote_fits(\n",
    "    day=date(2023, 6, 15),\n",
    "    hour=14,  # UTC hour (0-23)\n",
    "    station_substring=\"alaska\"  # Case-insensitive station filter\n",
    ")\n",
    "\n",
    "print(f\"Found {len(remote_files)} files:\")\n",
    "for rf in remote_files[:5]:  # Show first 5\n",
    "    print(f\"  - {rf.name}\")\n",
    "    print(f\"    URL: {rf.url}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Downloaded: downloaded_data/ALASKA-ANCHORAGE_20230615_143000_01.fit.gz\n",
      "Downloaded: downloaded_data/ALASKA-ANCHORAGE_20230615_144500_01.fit.gz\n"
     ]
    }
   ],
   "source": [
    "#Download files to local directory\n",
    "saved_paths = ecl.download_files(remote_files[:2], out_dir=\"./downloaded_data\")\n",
    " \n",
    "for path in saved_paths:\n",
    "    print(f\"Downloaded: {path}\")\n",
    "\n",
    "#print(\"(Uncomment above to download files)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Download Reliability Options (v1.1.0)\n",
    "\n",
    "Use retries, parallel workers, and overwrite policy controls in `download_files()`.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[PosixPath('downloaded_data/ALASKA-ANCHORAGE_20230615_143000_01.fit.gz'), PosixPath('downloaded_data/ALASKA-ANCHORAGE_20230615_144500_01.fit.gz'), PosixPath('downloaded_data/ALASKA-COHOE_20230615_140000_62.fit.gz'), PosixPath('downloaded_data/ALASKA-COHOE_20230615_140000_63.fit.gz')]\n"
     ]
    }
   ],
   "source": [
    "# v1.1.0: Download with retries/parallel/overwrite options\n",
    "saved_paths = ecl.download_files(\n",
    "     remote_files[:4],\n",
    "     out_dir=\"./downloaded_data\",\n",
    "     workers=4,\n",
    "     retries=2,\n",
    "     retry_backoff_s=0.5,\n",
    "     overwrite=\"skip\",  # \"replace\" (default), \"skip\", or \"error\"\n",
    " )\n",
    "print(saved_paths)\n",
    "\n",
    "#print(\"(Uncomment above to run v1.1.0 download options example)\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Querying Multiple Days (v1.0.0)\n",
    "\n",
    "Use `list_remote_fits_range()` to query files across a date range:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Found 110 files across date range\n"
     ]
    }
   ],
   "source": [
    "# v1.0.0: Query multiple days at once\n",
    "files = ecl.list_remote_fits_range(\n",
    "     start_date=date(2023, 6, 1),\n",
    "     end_date=date(2023, 6, 3),\n",
    "     hours=[12, 13, 14],\n",
    "     station_substring=\"alaska\"\n",
    " )\n",
    "print(f\"Found {len(files)} files across date range\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "## 3. Processing Data\n",
    "\n",
    "### Background Subtraction\n",
    "\n",
    "Remove the mean per frequency channel (no clipping)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original data range: 0.0 to 254.0\n",
      "After background subtraction: -126.1 to 127.9\n",
      "Mean per channel is now ~0: [ 6.06329801e-15  3.28428642e-15 -1.01054967e-15]\n"
     ]
    }
   ],
   "source": [
    "# Apply background subtraction only\n",
    "ds_bg = ecl.background_subtract(ds)\n",
    "\n",
    "print(f\"Original data range: {ds.data.min():.1f} to {ds.data.max():.1f}\")\n",
    "print(f\"After background subtraction: {ds_bg.data.min():.1f} to {ds_bg.data.max():.1f}\")\n",
    "print(f\"Mean per channel is now ~0: {ds_bg.data.mean(axis=1)[:3]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Noise Reduction\n",
    "\n",
    "Apply mean subtraction + clipping + optional scaling."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "After noise reduction: -1.9 to 7.7\n",
      "Processing metadata: {'method': 'mean_subtract_clip', 'clip_low': -5, 'clip_high': 20, 'scale': 0.38598116411919103}\n"
     ]
    }
   ],
   "source": [
    "# Noise reduction with default parameters\n",
    "ds_reduced = ecl.noise_reduce_mean_clip(ds, clip_low=-5, clip_high=20)\n",
    "\n",
    "print(f\"After noise reduction: {ds_reduced.data.min():.1f} to {ds_reduced.data.max():.1f}\")\n",
    "print(f\"Processing metadata: {ds_reduced.meta.get('noise_reduction')}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Custom params: -2.0 to 15.0\n"
     ]
    }
   ],
   "source": [
    "# Custom noise reduction parameters\n",
    "ds_custom = ecl.noise_reduce_mean_clip(\n",
    "    ds,\n",
    "    clip_low=-2.0,   # Lower clipping threshold\n",
    "    clip_high=15.0,  # Upper clipping threshold\n",
    "    scale=None       # Disable scaling\n",
    ")\n",
    "\n",
    "print(f\"Custom params: {ds_custom.data.min():.1f} to {ds_custom.data.max():.1f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Median-Based Noise Reduction (v1.0.0)\n",
    "\n",
    "For data with outliers, use `noise_reduce_median_clip()` which is more robust:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Method used: median_subtract_clip\n"
     ]
    }
   ],
   "source": [
    "# v1.0.0: Median-based noise reduction (more robust to outliers)\n",
    "cleaned_median = ecl.noise_reduce_median_clip(ds, clip_low=-5, clip_high=20)\n",
    "print(f\"Method used: {cleaned_median.meta['noise_reduction']['method']}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "## 4. Cropping & Slicing\n",
    "\n",
    "### Crop by Physical Values"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Cropped frequency: 30.1 - 79.9 MHz\n",
      "Shape: (200, 3600) -> (134, 3600)\n"
     ]
    }
   ],
   "source": [
    "# Crop frequency range (in MHz)\n",
    "ds_freq = ecl.crop_frequency(ds, freq_min=30, freq_max=80)\n",
    "print(f\"Cropped frequency: {ds_freq.freqs_mhz.min():.1f} - {ds_freq.freqs_mhz.max():.1f} MHz\")\n",
    "print(f\"Shape: {ds.shape} -> {ds_freq.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Cropped time: 100.0 - 500.0 s\n",
      "Shape: (200, 3600) -> (200, 1601)\n"
     ]
    }
   ],
   "source": [
    "# Crop time range (in seconds)\n",
    "ds_time = ecl.crop_time(ds, time_min=100, time_max=500)\n",
    "print(f\"Cropped time: {ds_time.time_s.min():.1f} - {ds_time.time_s.max():.1f} s\")\n",
    "print(f\"Shape: {ds.shape} -> {ds_time.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Cropped both: (200, 3600) -> (53, 401)\n",
      "Crop metadata: {'frequency': {'min': 40, 'max': 60}, 'time': {'min': 200, 'max': 300}}\n"
     ]
    }
   ],
   "source": [
    "# Crop both axes at once\n",
    "ds_both = ecl.crop(ds, freq_range=(40, 60), time_range=(200, 300))\n",
    "print(f\"Cropped both: {ds.shape} -> {ds_both.shape}\")\n",
    "print(f\"Crop metadata: {ds_both.meta.get('cropped')}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Slice by Array Index"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Sliced: (200, 3600) -> (50, 500)\n"
     ]
    }
   ],
   "source": [
    "# Get first 50 frequency channels and first 500 time samples\n",
    "ds_sliced = ecl.slice_by_index(\n",
    "    ds,\n",
    "    freq_slice=slice(0, 50),\n",
    "    time_slice=slice(0, 500)\n",
    ")\n",
    "print(f\"Sliced: {ds.shape} -> {ds_sliced.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Downsampled: (200, 3600) -> (100, 1800)\n"
     ]
    }
   ],
   "source": [
    "# Downsample by taking every other sample\n",
    "ds_down = ecl.slice_by_index(\n",
    "    ds,\n",
    "    freq_slice=slice(None, None, 2),  # Every other frequency\n",
    "    time_slice=slice(None, None, 2)   # Every other time sample\n",
    ")\n",
    "print(f\"Downsampled: {ds.shape} -> {ds_down.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "## 5. Combining Spectra\n",
    "\n",
    "### Combine Along Time Axis\n",
    "\n",
    "Concatenate spectra recorded consecutively (same station, focus, frequency range)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Files CAN be combined along time axis\n",
      "Combined shape: (200, 7200)\n",
      "Timeline mode: actual\n",
      "Segment offsets (s): [0.0, 900.0]\n"
     ]
    }
   ],
   "source": [
    "# Example: combine consecutive files while preserving real segment offsets\n",
    "files_time = [\n",
    "    \"/Users/saan/Desktop/ecallistolib/data/Arecibo-Observatory_20220302_173000_62.fit.gz\",\n",
    "    \"/Users/saan/Desktop/ecallistolib/data/Arecibo-Observatory_20220302_174500_62.fit.gz\",\n",
    "]\n",
    "\n",
    "# Check compatibility (same station, focus, matching frequency axes)\n",
    "if ecl.can_combine_time(files_time):\n",
    "    print(\"Files CAN be combined along time axis\")\n",
    "    combined = ecl.combine_time(files_time, timeline=\"actual\")\n",
    "    print(f\"Combined shape: {combined.shape}\")\n",
    "    print(f\"Timeline mode: {combined.meta['combined']['timeline']}\")\n",
    "    print(f\"Segment offsets (s): {combined.meta['combined']['segment_offsets_s']}\")\n",
    "else:\n",
    "    print(\"Files cannot be combined (check station/focus/frequencies)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Timeline Modes (v1.2.0)\n",
    "\n",
    "`combine_time()` now supports `timeline=\"actual\"` to preserve real offsets between segment start times.\n",
    "\n",
    "Use `timeline=\"contiguous\"` when you want a gap-free synthetic timeline, and combine it with `normalize_segment_time=True` when later segments have non-zero local time axes."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Actual timeline: actual\n",
      "Contiguous timeline: legacy\n",
      "Normalized contiguous timeline: normalized\n",
      "Actual offsets (s): [0.0, 900.0]\n",
      "freq_atol used: 0.01\n"
     ]
    }
   ],
   "source": [
    "# Compare actual vs contiguous timeline behavior\n",
    "if ecl.can_combine_time(files_time):\n",
    "    combined_actual = ecl.combine_time(files_time, timeline=\"actual\")\n",
    "    combined_contiguous = ecl.combine_time(files_time, timeline=\"contiguous\")\n",
    "    combined_normalized = ecl.combine_time(\n",
    "        files_time,\n",
    "        timeline=\"contiguous\",\n",
    "        normalize_segment_time=True,\n",
    "        freq_atol=0.01,\n",
    "    )\n",
    "\n",
    "    print(\"Actual timeline:\", combined_actual.meta[\"combined\"][\"time_alignment\"])\n",
    "    print(\"Contiguous timeline:\", combined_contiguous.meta[\"combined\"][\"time_alignment\"])\n",
    "    print(\"Normalized contiguous timeline:\", combined_normalized.meta[\"combined\"][\"time_alignment\"])\n",
    "    print(\"Actual offsets (s):\", combined_actual.meta[\"combined\"][\"segment_offsets_s\"])\n",
    "    print(\"freq_atol used:\", combined_normalized.meta[\"combined\"][\"freq_atol\"])\n",
    "else:\n",
    "    print(\"files_time is not compatible for combine_time\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Combine Along Frequency Axis\n",
    "\n",
    "Stack spectra from different frequency bands (same station, time, different focus)."
   ]
